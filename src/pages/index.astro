---
import { BaseInfoSection } from '../components/home/BaseInfoSection';
import { CountdownSection } from '../components/home/CountdownSection';
import { GalleryPreview } from '../components/home/GalleryPreview';
import { Map } from '../components/home/Map';
import { UsefulLinkList } from '../components/home/UsefulLinkList';
import { WhatIsMajalesSection } from '../components/home/WhatIsMajalesSection';
import Layout from '../components/shared/Layout.astro';
import { SectionHero } from '../components/shared/SectionHero';
import { MAJALES_DATE } from '../config/constants';

const metaTags = {
  title: 'Majáles UTB',
  description: 'Majáles UTB ve Zlíně. Vstup ZDARMA. Baťa by šel! Hudba, kultura a zábava v srdci města.',
};
---

<Layout {...metaTags}>
  <SectionHero client:load />

  <CountdownSection targetDate={MAJALES_DATE} client:load />

  <WhatIsMajalesSection client:load />

  <BaseInfoSection client:visible />

  <GalleryPreview client:visible />

  <Map client:visible />

  <UsefulLinkList client:visible />

  {/* <AboutSection /> */}
</Layout>
