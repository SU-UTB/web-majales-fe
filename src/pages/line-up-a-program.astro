---
import { BandListSection } from '../components/lineup/BandListSection';
import { HarmonogramSection } from '../components/lineup/HarmonogramSection';
import { Doprogram } from '../components/lineup/Doprogram';
import { MapSection } from '../components/lineup/MapSection';
import Layout from '../components/shared/Layout.astro';
import { CAN_SHOW_HARMONOGRAM, CAN_SHOW_DOPROGRAM } from '../config/constants';

const metaTags = {
  title: 'Lineup a program | Majáles UTB',
  description: 'Na koho se můžete těšit? Již brzy prozradíme!',
  //image: '/meta_image.jpg',
};
---

<Layout {...metaTags}>
  <BandListSection client:load />
  {CAN_SHOW_HARMONOGRAM && <HarmonogramSection client:load />}
  {CAN_SHOW_HARMONOGRAM && <MapSection client:load />}
  {CAN_SHOW_DOPROGRAM && <Doprogram client:load />}
</Layout>
